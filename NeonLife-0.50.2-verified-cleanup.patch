-  if (supplyClass === "parts") return CARGO.find((cargo) => cargo.cargoClass === "parts") ?? CARGO[0];
-  if (supplyClass === "documents") return CARGO.find((cargo) => cargo.cargoClass === "documents") ?? CARGO[0];
